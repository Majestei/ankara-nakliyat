# Google Search Console read-only integration placeholders. Keep secrets in
# .env.seo.local, which is ignored by Git.
GSC_CREDENTIALS_PATH=
GSC_ACCESS_TOKEN=
# Mülkler farklı Google hesaplarındaysa siteye özel read-only kimlikler kullanın.
GSC_OZDEMIR_CREDENTIALS_PATH=
GSC_OZDEMIR_ACCESS_TOKEN=
GSC_AKIF_CREDENTIALS_PATH=
GSC_AKIF_ACCESS_TOKEN=
GSC_OZDEMIR_PROPERTY=https://ankaraozdemirnakliyat.com/
GSC_AKIF_PROPERTY=https://www.ankaraakifnakliyat.com/
# Set to 1 to run URL Inspection against every sitemap URL (quota intensive).
GSC_INSPECT=0

# SerpApi: real Google, Ankara/Turkey, Turkish, mobile-first.
SERPAPI_API_KEY=
SERP_LOCATION=Ankara,Turkey
SERP_DEVICE=mobile
